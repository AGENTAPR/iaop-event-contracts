  "$id": "https://contracts.iaop.internal/events/agency.status-changed.schema.json",
  "title": "agency.status-changed",
  "description": "Payload for `agency.status-changed` v1 \u2014 agency lifecycle transition (SUSPEND/REINSTATE/TERMINATE).",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.iaop.internal/events/integration.callback-received.schema.json",
  "title": "integration.callback-received",
  "description": "Payload schema for `integration.callback-received` v1. Emitted when an external provider callback is authenticated and received.",

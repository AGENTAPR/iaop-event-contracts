{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.iaop.internal/events/integration.operation-dispatched.schema.json",
  "title": "integration.operation-dispatched",
  "description": "Payload schema for `integration.operation-dispatched` v1. Emitted when an external operation is dispatched to a connector.",
  "x-status": "DRAFT",
  "x-privacy": "internal",
  "x-producer": "iaop-integration-service",
  "x-consumers": [
    "iaop-workflow-service",
    "iaop-observability"
  ],
  "type": "object",
  "required": [
    "operationId",
    "provider",
    "operationType",
    "attemptNumber"
  ],
  "additionalProperties": true,
  "properties": {
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string"
    },
    "requestingService": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "operationType": {
      "type": "string"
    },
    "businessReference": {
      "type": "string"
    },
    "attemptNumber": {
      "type": "integer",
      "minimum": 1
    }
  }
}

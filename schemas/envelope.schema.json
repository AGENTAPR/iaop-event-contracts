{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.iaop.internal/events/envelope.schema.json",
  "title": "IAOP Integration Event Envelope",
  "description": "Canonical envelope for all IAOP integration events (v1).",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "source",
    "occurredAt",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  }
}
